# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Allowed Telegram Usernames or Chat IDs (comma-separated, leave blank to allow all)
ALLOWED_TELEGRAM_USERS=

# LLM Router Settings (Supports 9router, OpenCode, OpenAI, Groq, Ollama)
# For 9router: ROUTER_API_BASE=http://localhost:8080/v1 (or your remote 9router endpoint)
ROUTER_API_BASE=https://api.openai.com/v1
ROUTER_API_KEY=your_llm_api_key_here
ROUTER_MODEL=claude-3-5-sonnet
